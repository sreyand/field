<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FIELD</AssemblyName>
    <RootNamespace>Field.Desktop</RootNamespace>
    <Version>0.1.1-alpha</Version>
    <FileVersion>0.1.1.0</FileVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <Product>FIELD</Product>
    <Description>FIELD personal archive</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>field.ico</ApplicationIcon>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <ProjectReference Include="..\Field.Native\Field.Native.csproj" />
    <Resource Include="field.ico" />
  </ItemGroup>
</Project>
